# .gitignore (Place this file in the major_project/ root directory)

# Node Dependencies
# Ignore node_modules in backend
backend/node_modules/
# Ignore node_modules in frontend (if you add a complex frontend later)
# frontend/node_modules/

# Environment Variables - CRITICAL FOR SECURITY
# Ignore .env files and similar variants in backend
backend/.env*
# Ignore .env files in frontend (if added later)
# frontend/.env*

backend/your-project-id-a1b2c3d4e5f6.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs
*.log.*.[0-9]
*.log.[0-9]

# Temporary Files generated by Backend Worker
# Ignore the directory where temporary PDFs/Screenshots might be saved
backend/temp_pdfs/
# Ignore specific temporary files if not in a dedicated directory (less ideal)
# backend/temp_report_*.pdf
# backend/temp_screenshot_*.png
# backend/temp_login_fail_*.png

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories (remove the comment below if you use Bower)
# bower_components

# Optional dependency fisheries
*.node
*.js.map

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.development.local
.env.test.local
.env.production.local

#parcel cache
.cache

# Next.js build output (If frontend uses Next.js)
# frontend/.next/
# frontend/out/

# VS Code specific
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Mac specific
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
Thumbs.db
ehthumbs.db
ehthumbs_vista.db

# Linux thumbnail cache files
.cache

# Windows thumbnail cache files
._*

# Build output directories (add others specific to your build tools if any)
dist/
build/
out/
# If frontend builds into backend public folder (less common now)
# backend/public/

# Browser extension specific build artifacts (if using build tools)
# social-parser-extension/dist/
# social-parser-extension/build/
# social-parser-extension/*.crx
# social-parser-extension/*.xpi
# social-parser-extension/*.zip

# IDE specific folders/files
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?